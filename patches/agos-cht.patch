+// 非上游: ELVIRA logo 下疊「古堡禁地」(自建 CJK 路徑, 24px 直繪 320x200 螢幕, 帶 1px 描邊)。
+// 僅在 title 閂鎖期間由 displayScreen 每幀呼叫(進遊戲後關)。呼叫端在螢幕未鎖時呼叫。
+void AGOSEngine::chtDrawTitle() {
+	if (!_cht.font)
+		return;
+	static const byte kTitle[] = {0xa5,0x6a, 0xb3,0xf9, 0xb8,0x54, 0xa6,0x61, 0};  // 古堡禁地
+	const int fw = _cht.fontW, fh = _cht.fontH, bpr = _cht.fontBpr;
+	int nchar = 4, gap = 8;
+	int totalW = nchar * fw + (nchar - 1) * gap;
+	Graphics::Surface *scr = getBackendSurface();
+	int x0 = (scr->w - totalW) / 2;   // 水平置中
+	int y0 = 138;                     // ELVIRA logo 下方
+	byte fill = chtReadableColor(15), edge = chtOutlineColor();
+	byte *sp = (byte *)scr->getPixels();
+	uint pitch = scr->pitch;
+	int cx = x0;
+	for (const byte *s = kTitle; *s; s += 2) {
+		const byte *g = _cht.glyph(s[0], s[1]);
+		if (g) {
+			for (int pass = 0; pass < 2; pass++) {
+				byte col = (pass == 0) ? edge : fill;
+				for (int row = 0; row < fh; row++) {
+					const byte *gr = g + row * bpr;
+					for (int c = 0; c < fw; c++) {
+						if (!(gr[c >> 3] & (0x80 >> (c & 7))))
+							continue;
+						if (pass == 0) {
+							for (int dy = -1; dy <= 1; dy++) for (int dx = -1; dx <= 1; dx++) {
+								int xx = cx + c + dx, yy = y0 + row + dy;
+								if (xx >= 0 && xx < scr->w && yy >= 0 && yy < scr->h) sp[yy * pitch + xx] = col;
+							}
+						} else {
+							int xx = cx + c, yy = y0 + row;
+							if (xx >= 0 && xx < scr->w && yy >= 0 && yy < scr->h) sp[yy * pitch + xx] = col;
+						}
+					}
+				}
+			}
+		}
+		cx += fw + gap;
+	}
+	Common::Rect dirty(x0 - 1, y0 - 1, x0 + totalW + 1, y0 + fh + 1);
+	if (dirty.left < 0) dirty.left = 0;
+	if (dirty.right > scr->w) dirty.right = scr->w;
+	if (dirty.bottom > scr->h) dirty.bottom = scr->h;
+	updateBackendSurface(&dirty);
+}
