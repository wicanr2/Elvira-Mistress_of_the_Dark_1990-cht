+	uint32 palEnc[256];
+	for (int i = 0; i < 256; i++)
+		palEnc[i] = fmt.RGBToColor(_currentPalette[i * 3], _currentPalette[i * 3 + 1], _currentPalette[i * 3 + 2]);
+	// 升採遊戲畫面 (nearest)
+	const byte *src = (const byte *)game->getPixels();
+	uint gpitch = game->pitch;
+	for (int oy = 0; oy < oh; oy++) {
+		const byte *srow = src + (oy / sy) * gpitch;
+		byte *drow = _chtOvlBuf + (uint)oy * ow * bpp;
+		if (bpp == 2) {
+			uint16 *d = (uint16 *)drow;
+			for (int ox = 0; ox < ow; ox++)
+				d[ox] = (uint16)palEnc[srow[ox / sx]];
+		} else {
+			uint32 *d = (uint32 *)drow;
+			for (int ox = 0; ox < ow; ox++)
+				d[ox] = palEnc[srow[ox / sx]];
+		}
+	}
+	// getBackendSurface() 非-hires = _system->lockScreen(); 讀完遊戲畫面立即解鎖(下方只寫 _chtOvlBuf)。
+	_system->unlockScreen();
+	// 地圖: 記錄當前房間為已探索; 地圖開啟時疊在遊戲區上。
+	{
+		Item *pl = me();
+		Item *cr = pl ? derefItem(pl->parent) : nullptr;
+		if (cr && isRoom(cr))
+			_chtVisited[(uint16)itemPtrToID(cr)] = 1;
+	}
+	if (_chtMapOn)
+		chtDrawMap();
+	// ── 在 overlay 畫 16px 動詞面板中文 ── (cy = overlay 640x400 座標中心; 英文右對齊至右緣)
+	struct VLabel { int16 cy; byte b[4]; };  // 右欄; 左欄另列
+	static const VLabel kRight[] = {
+		{ 31, {0xb6,0x7d,0xb1,0xd2}},  // 開啟 OPEN
+		{ 49, {0xc3,0xf6,0xb3,0xac}},  // 關閉 CLOSE
+		{ 67, {0xa4,0x57,0xc2,0xea}},  // 上鎖 LOCK
+		{ 85, {0xb8,0xd1,0xc2,0xea}},  // 解鎖 UNLOCK
+		{103, {0xac,0x64,0xac,0xdd}},  // 查看 LOOK IN
+		{121, {0xc0,0xcb,0xb5,0xf8}},  // 檢視 EXAMINE
+		{139, {0xbd,0xd5,0xb0,0x74}},  // 調配 MIX
+		{157, {0xad,0xb9,0xa5,0xce}},  // 食用 CONSUME
+		{175, {0xa8,0xcf,0xa5,0xce}},  // 使用 USE
+		{193, {0xa7,0xeb,0xc2,0x59}},  // 投擲 THROW
+		{230, {0xbc,0xc8,0xb0,0xb1}},  // 暫停 PAUSE
+		{248, {0xa6,0x73,0xc0,0xc9}},  // 存檔 SAVE
+		{266, {0xc5,0xaa,0xc0,0xc9}},  // 讀檔 RESTORE
+	};
+	static const VLabel kLeft[] = {
+		{ 45, {0xa9,0xd0,0xb6,0xa1}},   // 房間 ROOM
+		{ 67, {0xaa,0xab,0xab,0x7e}},   // 物品 INV
+		{ 88, {0xaa,0x5a,0xbe,0xb9}},   // 武器 WEAPONS
+	};
+	const int fw = _cht.fontW16, fh = _cht.fontH16, bpr = _cht.fontBpr16;
+	uint32 cWhite = fmt.RGBToColor(235, 235, 210);
+	uint32 cBlack = fmt.RGBToColor(0, 0, 0);
+	// 整塊黑底(涵蓋整個文字區, 保證升採後的英文美術字全被蓋掉, 個別 Y 稍偏也不露)
+	// 右欄文字區: x560-640, y22-282; 左欄 ROOM/INV/WEAPONS: x6-90, y36-104。
+	for (int yy = 22; yy < 282; yy++)
+		for (int xx = 554; xx < 640; xx++) {
+			if (bpp == 2) ((uint16 *)_chtOvlBuf)[yy * ow + xx] = (uint16)cBlack;
+			else ((uint32 *)_chtOvlBuf)[yy * ow + xx] = cBlack;
+		}
+	for (int yy = 28; yy < 102; yy++)
+		for (int xx = 6; xx < 90; xx++) {
+			if (bpp == 2) ((uint16 *)_chtOvlBuf)[yy * ow + xx] = (uint16)cBlack;
+			else ((uint32 *)_chtOvlBuf)[yy * ow + xx] = cBlack;
+		}
+	int nAll = ARRAYSIZE(kRight) + ARRAYSIZE(kLeft);
+	for (int li = 0; li < nAll; li++) {
+		bool left = (li >= (int)ARRAYSIZE(kRight));
+		const VLabel &L = left ? kLeft[li - (int)ARRAYSIZE(kRight)] : kRight[li];
+		int x0 = left ? 30 : 592;      // 左欄 x30 起; 右欄 x592(2 字 32px → 592-624, 置中於 560-640)
+		int y0 = L.cy - fh / 2;
+		// 畫 2 個 Big5 字(pass0 描邊 pass1 本體)
+		for (int ci = 0; ci < 2; ci++) {
+			const byte *g = _cht.glyph16(L.b[ci * 2], L.b[ci * 2 + 1]);
+			if (!g)
+				continue;
+			int cx = x0 + ci * fw;
+			for (int pass = 0; pass < 2; pass++) {
+				uint32 col = (pass == 0) ? cBlack : cWhite;
+				for (int row = 0; row < fh; row++) {
+					const byte *gr = g + row * bpr;
+					for (int c = 0; c < fw; c++) {
+						if (!(gr[c >> 3] & (0x80 >> (c & 7))))
+							continue;
+						if (pass == 0) {
+							for (int dy = -1; dy <= 1; dy++)
+								for (int dx = -1; dx <= 1; dx++) {
+									int xx = cx + c + dx, yy = y0 + row + dy;
+									if (xx >= 0 && xx < ow && yy >= 0 && yy < oh) {
+										if (bpp == 2) ((uint16 *)_chtOvlBuf)[yy * ow + xx] = (uint16)col;
+										else ((uint32 *)_chtOvlBuf)[yy * ow + xx] = col;
+									}
+								}
+						} else {
+							int xx = cx + c, yy = y0 + row;
+							if (xx >= 0 && xx < ow && yy >= 0 && yy < oh) {
+								if (bpp == 2) ((uint16 *)_chtOvlBuf)[yy * ow + xx] = (uint16)col;
+								else ((uint32 *)_chtOvlBuf)[yy * ow + xx] = col;
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+	// 無敵(F7)指示器: 遊戲區頂端疊「無敵模式」(16px, 亮黃 + 描邊 + 深底框, 任意背景皆可見)
+	if (_chtGodMode && _cht.font16) {
+		static const byte kGod[] = {0xb5,0x4c, 0xbc,0xc4, 0xbc,0xd2, 0xa6,0xa1, 0};  // 無敵模式
+		int gx = 210, gy = 6;   // overlay 座標(遊戲區頂端中央偏左)
+		uint32 gcol = fmt.RGBToColor(255, 235, 60), gol = fmt.RGBToColor(0, 0, 0);
+		uint32 gbg = fmt.RGBToColor(20, 20, 20);
+		for (int yy = gy - 2; yy < gy + _cht.fontH16 + 2; yy++)
+			for (int xx = gx - 3; xx < gx + 4 * _cht.fontW16 + 3; xx++)
+				if (xx >= 0 && xx < ow && yy >= 0 && yy < oh) {
+					if (bpp == 2) ((uint16 *)_chtOvlBuf)[yy * ow + xx] = (uint16)gbg;
+					else ((uint32 *)_chtOvlBuf)[yy * ow + xx] = gbg;
+				}
+		int cx = gx;
+		for (const byte *s = kGod; *s; s += 2) {
+			const byte *g = _cht.glyph16(s[0], s[1]);
+			if (g) {
+				for (int pass = 0; pass < 2; pass++) {
+					uint32 c = (pass == 0) ? gol : gcol;
+					for (int row = 0; row < _cht.fontH16; row++) {
+						const byte *gr = g + row * _cht.fontBpr16;
+						for (int col = 0; col < _cht.fontW16; col++) {
+							if (!(gr[col >> 3] & (0x80 >> (col & 7)))) continue;
+							if (pass == 0) {
+								for (int dy = -1; dy <= 1; dy++) for (int dx = -1; dx <= 1; dx++) {
+									int xx = cx + col + dx, yy = gy + row + dy;
+									if (xx >= 0 && xx < ow && yy >= 0 && yy < oh) {
+										if (bpp == 2) ((uint16 *)_chtOvlBuf)[yy * ow + xx] = (uint16)c;
+										else ((uint32 *)_chtOvlBuf)[yy * ow + xx] = c;
+									}
+								}
+							} else {
+								int xx = cx + col, yy = gy + row;
+								if (xx >= 0 && xx < ow && yy >= 0 && yy < oh) {
+									if (bpp == 2) ((uint16 *)_chtOvlBuf)[yy * ow + xx] = (uint16)c;
+									else ((uint32 *)_chtOvlBuf)[yy * ow + xx] = c;
+								}
+							}
+						}
+					}
+				}
+			}
+			cx += _cht.fontW16;
+		}
+	}
+	// 疊上持久 CJK 文字層(對白/敘述, cov==1 處覆蓋)
+	uint npix = (uint)ow * oh;
+	if (bpp == 2) {
+		const uint16 *tl = (const uint16 *)_chtTextLayer;
+		uint16 *ob = (uint16 *)_chtOvlBuf;
+		for (uint i = 0; i < npix; i++)
+			if (_chtTextCov[i]) ob[i] = tl[i];
+	} else {
+		const uint32 *tl = (const uint32 *)_chtTextLayer;
+		uint32 *ob = (uint32 *)_chtOvlBuf;
+		for (uint i = 0; i < npix; i++)
+			if (_chtTextCov[i]) ob[i] = tl[i];
+	}
+	_system->copyRectToOverlay(_chtOvlBuf, ow * bpp, 0, 0, ow, oh);
+}
+
+// 地圖(TAB): 從當前房間 BFS 走已探索的 N/E/S/W 出口鋪 2D 格, 畫進 overlay 遊戲區。
+// 房間框 + 連線 + 當前房間高亮(黃); 探索迷霧: 只顯示 _chtVisited 過的房間。
+void AGOSEngine::chtDrawMap() {
+	if (!_chtOvlBuf)
+		return;
+	Item *player = me();
+	Item *cur = player ? derefItem(player->parent) : nullptr;
+	if (!cur || !isRoom(cur))
+		return;
+	const int ow = _chtOvlW, oh = _chtOvlH, bpp = _chtOvlBpp;
+	Graphics::PixelFormat fmt = _system->getOverlayFormat();
+	uint32 cBg = fmt.RGBToColor(12, 12, 24), cBorder = fmt.RGBToColor(180, 180, 190);
+	uint32 cRoom = fmt.RGBToColor(90, 90, 110), cCur = fmt.RGBToColor(255, 220, 40);
+	uint32 cLink = fmt.RGBToColor(150, 150, 160), cTxt = fmt.RGBToColor(235, 235, 210);
+#define CHT_PX(X, Y, C) do { int _x=(X),_y=(Y); if(_x>=0&&_x<ow&&_y>=0&&_y<oh){ if(bpp==2)((uint16*)_chtOvlBuf)[_y*ow+_x]=(uint16)(C); else ((uint32*)_chtOvlBuf)[_y*ow+_x]=(C);} } while(0)
+
+	// BFS 已探索房間
+	struct MR { uint16 id; int16 gx, gy; };
+	static MR rooms[256];
+	int nr = 0;
+	Common::HashMap<uint16, int> seen;
+	uint16 curID = (uint16)itemPtrToID(cur);
+	rooms[nr].id = curID; rooms[nr].gx = 0; rooms[nr].gy = 0; seen[curID] = nr; nr++;
+	static const int8 dxx[4] = {0, 1, 0, -1}, dyy[4] = {-1, 0, 1, 0};   // N,E,S,W
+	for (int qi = 0; qi < nr; qi++) {
+		Item *ri = derefItem(rooms[qi].id);
+		if (!ri) continue;
+		for (int d = 0; d < 4; d++) {
+			Item *nb = getExitOf_e1(ri, d);
+			if (!nb || !isRoom(nb)) continue;
+			uint16 nid = (uint16)itemPtrToID(nb);
+			if (nid != curID && !_chtVisited.contains(nid)) continue;   // 迷霧: 只走探索過
+			if (seen.contains(nid)) continue;
+			if (nr >= 256) break;
+			rooms[nr].id = nid;
+			rooms[nr].gx = rooms[qi].gx + dxx[d];
+			rooms[nr].gy = rooms[qi].gy + dyy[d];
+			seen[nid] = nr; nr++;
+		}
+	}
+	// 邊界
+	int minx = 9999, maxx = -9999, miny = 9999, maxy = -9999;
+	for (int i = 0; i < nr; i++) {
+		minx = MIN(minx, (int)rooms[i].gx); maxx = MAX(maxx, (int)rooms[i].gx);
+		miny = MIN(miny, (int)rooms[i].gy); maxy = MAX(maxy, (int)rooms[i].gy);
+	}
+	int cols = maxx - minx + 1, rows = maxy - miny + 1;
+	// 地圖面板(遊戲區中央): overlay x96..544, y28..288
+	int pL = 96, pT = 28, pR = 544, pB = 288;
+	for (int yy = pT; yy < pB; yy++)
+		for (int xx = pL; xx < pR; xx++) CHT_PX(xx, yy, cBg);
+	// 面板邊框
+	for (int xx = pL; xx < pR; xx++) { CHT_PX(xx, pT, cBorder); CHT_PX(xx, pB - 1, cBorder); }
+	for (int yy = pT; yy < pB; yy++) { CHT_PX(pL, yy, cBorder); CHT_PX(pR - 1, yy, cBorder); }
+	// 標題「地圖」(24px, 頂端置中)
+	if (_cht.font) {
+		static const byte kMap[] = {0xa6,0x61, 0xb9,0xcf, 0};   // 地圖
+		int tw = 2 * _cht.fontW, tx = (pL + pR) / 2 - tw / 2, ty = pT + 4;
+		int cxp = tx;
+		for (const byte *s = kMap; *s; s += 2) {
+			const byte *g = _cht.glyph(s[0], s[1]);
+			if (g) for (int row = 0; row < _cht.fontH; row++) {
+				const byte *gr = g + row * _cht.fontBpr;
+				for (int c = 0; c < _cht.fontW; c++)
+					if (gr[c >> 3] & (0x80 >> (c & 7))) CHT_PX(cxp + c, ty + row, cTxt);
+			}
+			cxp += _cht.fontW;
+		}
+	}
+	// 格子尺寸(留標題空間 + 邊距)
+	int gridT = pT + 34, gridB = pB - 10, gridL = pL + 12, gridR = pR - 12;
+	int cellW = MIN(56, (gridR - gridL) / MAX(1, cols));
+	int cellH = MIN(40, (gridB - gridT) / MAX(1, rows));
+	if (cellW < 10) cellW = 10;
+	if (cellH < 10) cellH = 10;
+	int roomW = cellW - 8, roomH = cellH - 8;
+	if (roomW < 6) roomW = 6;
+	if (roomH < 6) roomH = 6;
+	// 置中偏移
+	int usedW = cols * cellW, usedH = rows * cellH;
+	int offX = gridL + ((gridR - gridL) - usedW) / 2;
+	int offY = gridT + ((gridB - gridT) - usedH) / 2;
+	// 房間中心座標函式(內嵌)
+	// 先畫連線(相鄰已探索房間之間), 再畫房間框(蓋在連線上)
+	for (int i = 0; i < nr; i++) {
+		int cxi = offX + (rooms[i].gx - minx) * cellW + cellW / 2;
+		int cyi = offY + (rooms[i].gy - miny) * cellH + cellH / 2;
+		Item *ri = derefItem(rooms[i].id);
+		if (!ri) continue;
+		for (int d = 0; d < 4; d++) {
+			Item *nb = getExitOf_e1(ri, d);
+			if (!nb || !isRoom(nb)) continue;
+			uint16 nid = (uint16)itemPtrToID(nb);
+			if (!seen.contains(nid)) continue;
+			int j = seen[nid];
+			int cxj = offX + (rooms[j].gx - minx) * cellW + cellW / 2;
+			int cyj = offY + (rooms[j].gy - miny) * cellH + cellH / 2;
+			// 直線(僅水平/垂直, 因網格對齊)
+			if (cyi == cyj) { int a = MIN(cxi, cxj), b = MAX(cxi, cxj); for (int x = a; x <= b; x++) CHT_PX(x, cyi, cLink); }
+			else if (cxi == cxj) { int a = MIN(cyi, cyj), b = MAX(cyi, cyj); for (int y = a; y <= b; y++) CHT_PX(cxi, y, cLink); }
+		}
+	}
+	for (int i = 0; i < nr; i++) {
+		int rx = offX + (rooms[i].gx - minx) * cellW + (cellW - roomW) / 2;
+		int ry = offY + (rooms[i].gy - miny) * cellH + (cellH - roomH) / 2;
+		bool isCur = (rooms[i].id == curID);
+		uint32 fillc = isCur ? cCur : cRoom;
+		for (int yy = 0; yy < roomH; yy++)
+			for (int xx = 0; xx < roomW; xx++) CHT_PX(rx + xx, ry + yy, fillc);
+		for (int xx = 0; xx < roomW; xx++) { CHT_PX(rx + xx, ry, cBorder); CHT_PX(rx + xx, ry + roomH - 1, cBorder); }
+		for (int yy = 0; yy < roomH; yy++) { CHT_PX(rx, ry + yy, cBorder); CHT_PX(rx + roomW - 1, ry + yy, cBorder); }
+	}
+#undef CHT_PX
+}
+
+// 對白文字層排版常數(overlay 640x400 空間): 小字 14px, 壓縮格 16px 寬 / 18px 行高(比原生 2x=32
+// 緊湊)→ 對白小且貼合對話框、不觸框。引擎換行/捲動仍以原生 16px 格算, 這裡把 (char,line) index
+// 重映射到壓縮格; windowScroll 每 CJK 行呼叫 2 次, 故每次捲動 kChtDlgLineH/2。
+static const int kChtDlgCharW = 16;
+static const int kChtDlgLineH = 18;
+
+// 文字層寫入: 對白/敘述 CJK 改畫進 overlay 持久文字層(14px 小字, 壓縮格), 小巧清晰貼合對話框。
+// x,y = 原生 320x200 像素座標(x=window->x*8+textColumn*8, y=window->y+textRow*8)。
+void AGOSEngine::chtTextLayerPut(WindowBlock *window, uint x, uint y, byte lead, byte trail) {
+	if (!_chtTextLayer || !_chtTextCov)
+		return;
+	const byte *g = _cht.glyph14(lead, trail);
+	if (!g)
+		return;
+	const int fw = _cht.fontW14, fh = _cht.fontH14, bpr = _cht.fontBpr14;
+	const int ow = _chtOvlW, oh = _chtOvlH, bpp = _chtOvlBpp;
+	Graphics::PixelFormat fmt = _system->getOverlayFormat();
+	byte ti = chtReadableColor((byte)(window->textColor ? window->textColor : 15));
+	uint32 col = fmt.RGBToColor(_currentPalette[ti * 3], _currentPalette[ti * 3 + 1], _currentPalette[ti * 3 + 2]);
+	uint32 olc = fmt.RGBToColor(0, 0, 0);
+	// 由像素座標反推 CJK (char,line) index, 再映射到壓縮格(貼齊視窗左上角 overlay 座標)
+	int charIdx = ((int)x - window->x * 8) / 16;
+	int lineIdx = ((int)y - window->y) / 16;
+	if (charIdx < 0) charIdx = 0;
+	if (lineIdx < 0) lineIdx = 0;
+	int cellX = window->x * 16 + charIdx * kChtDlgCharW;
+	int cellY = window->y * 2 + lineIdx * kChtDlgLineH;
+	int bx = cellX + (kChtDlgCharW - fw) / 2, by = cellY + (kChtDlgLineH - fh) / 2;
+	for (int pass = 0; pass < 2; pass++) {
+		uint32 c = (pass == 0) ? olc : col;
+		for (int row = 0; row < fh; row++) {
+			const byte *gr = g + row * bpr;
+			for (int cc = 0; cc < fw; cc++) {
+				if (!(gr[cc >> 3] & (0x80 >> (cc & 7))))
+					continue;
+				if (pass == 0) {
+					for (int dy = -1; dy <= 1; dy++)
+						for (int dx = -1; dx <= 1; dx++) {
+							int xx = bx + cc + dx, yy = by + row + dy;
+							if (xx < 0 || xx >= ow || yy < 0 || yy >= oh) continue;
+							uint idx = yy * ow + xx;
+							if (bpp == 2) ((uint16 *)_chtTextLayer)[idx] = (uint16)c;
+							else ((uint32 *)_chtTextLayer)[idx] = c;
+							_chtTextCov[idx] = 1;
+						}
+				} else {
+					int xx = bx + cc, yy = by + row;
+					if (xx < 0 || xx >= ow || yy < 0 || yy >= oh) continue;
+					uint idx = yy * ow + xx;
+					if (bpp == 2) ((uint16 *)_chtTextLayer)[idx] = (uint16)c;
+					else ((uint32 *)_chtTextLayer)[idx] = c;
+					_chtTextCov[idx] = 1;
+				}
+			}
+		}
+	}
+}
+
+// 清除文字層某視窗區(overlay 座標, 鏡像 clearWindow 的 hires 矩形): window->x/width 單位 8px 欄, y/height 像素/8列。
+void AGOSEngine::chtTextLayerClear(WindowBlock *window) {
+	if (!_chtTextCov || !window)
+		return;
+	int hx = window->x * 16, hw = window->width * 16;
+	int hy = window->y * 2, hh = window->height * 16;
+	if (hx < 0) hx = 0;
+	if (hy < 0) hy = 0;
+	if (hx + hw > _chtOvlW) hw = _chtOvlW - hx;
+	if (hy + hh > _chtOvlH) hh = _chtOvlH - hy;
+	for (int yy = 0; yy < hh; yy++)
+		memset(_chtTextCov + (hy + yy) * _chtOvlW + hx, 0, hw > 0 ? hw : 0);
+}
+
+// 文字層向上捲(壓縮格: 每次 windowScroll 上移 kChtDlgLineH/2; windowPutChar 每 CJK 行呼叫兩次 = 一整行)。
+void AGOSEngine::chtTextLayerScroll(WindowBlock *window) {
+	if (!_chtTextLayer || !_chtTextCov || !window || window->height == 1)
+		return;
+	const int ow = _chtOvlW, bpp = _chtOvlBpp;
+	const int shift = kChtDlgLineH / 2;   // 9px; 兩次呼叫 = 一壓縮行
+	int hx = window->x * 16, hw = window->width * 16;
+	int hy = window->y * 2;
+	int ch = window->height * 16 - shift;   // 保留高度(overlay px)
+	if (hx < 0) hx = 0;
+	if (hy < 0) hy = 0;
+	if (hx + hw > ow) hw = ow - hx;
+	if (hw <= 0) return;
+	for (int r = 0; r < ch; r++) {
